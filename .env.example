# ---------------------------------------------------------------------------
# Database — matches the credentials in docker-compose.yml.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://sazkara:sazkara@localhost:5432/sazkara?schema=public"

# ---------------------------------------------------------------------------
# Sessions — signs the httpOnly session cookie. MUST be changed for any
# deployment. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-random-32-byte-hex-string"

# ---------------------------------------------------------------------------
# File storage. `local` writes under UPLOADS_DIR; swap the driver here once an
# S3 adapter is added in lib/storage/.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"

# ---------------------------------------------------------------------------
# Business timezone. Day boundaries (daily evidence PDFs, "today" on the
# dashboard, date-range exports) and Jalali conversion all use this.
# ---------------------------------------------------------------------------
APP_TIMEZONE="Asia/Tehran"

# ---------------------------------------------------------------------------
# Evidence PDF rendering. Puppeteer drives an already-installed Chrome or Edge
# rather than downloading its own Chromium — Chrome's text engine is what makes
# Persian RTL shaping in the PDFs correct. Leave blank to auto-detect.
# ---------------------------------------------------------------------------
CHROME_PATH=""

# ---------------------------------------------------------------------------
# Seed data — the first manager account, created by `npm run db:seed`.
# ---------------------------------------------------------------------------
SEED_MANAGER_NAME="مدیر تعمیرات"
SEED_MANAGER_PHONE="09120000000"
SEED_MANAGER_PASSWORD="manager1234"

# --- Jti supervisor (read-only client panel) -------------------------------------
# One shared login for Jti's team. The seed will NOT create this account unless
# SEED_CLIENT_PASSWORD is set: an account that can see the client's whole campaign
# should not have a password anyone can guess from this file.
SEED_CLIENT_PHONE="09121112000"
SEED_CLIENT_NAME="ناظر جی‌تی‌آی"
SEED_CLIENT_PASSWORD=""
