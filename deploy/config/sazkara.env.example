# Sazkara Maintenance — server settings.
# Install as /etc/sazkara/sazkara.env, owned by root, readable only by the sazkara user:
#   sudo install -o root -g sazkara -m 640 sazkara.env.example /etc/sazkara/sazkara.env
# Then replace every CHANGE_ME below.

# --- Database ---------------------------------------------------------------
# Use a password made of letters and digits only (e.g. `openssl rand -hex 24`), so it
# needs no escaping inside the URL.
DATABASE_URL="postgresql://sazkara:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/sazkara?schema=public"

# --- Sessions ---------------------------------------------------------------
# Signs the login cookie. Generate with:  openssl rand -hex 32
# Changing it later signs everyone out (harmless).
AUTH_SECRET="CHANGE_ME_64_HEX_CHARACTERS"

# --- Files ------------------------------------------------------------------
# Photos, signatures, imports and generated PDFs. Include this folder in backups.
STORAGE_DRIVER="local"
UPLOADS_DIR="/var/lib/sazkara/uploads"

# --- Time -------------------------------------------------------------------
# Day boundaries, "today" and Jalali dates all use this.
APP_TIMEZONE="Asia/Tehran"

# --- PDF rendering ----------------------------------------------------------
# Full path to Chrome or Chromium. Common values:
#   /usr/bin/google-chrome        (Google Chrome .deb)
#   /usr/bin/chromium             (Debian package)
#   /snap/bin/chromium            (Ubuntu snap)
CHROME_PATH="/usr/bin/google-chrome"

# --- First accounts (used once, by tools/seed.sh) ---------------------------
# After the first sign-in, change these passwords inside the app and you may delete
# the two *_PASSWORD lines.
SEED_MANAGER_NAME="مدیر تعمیرات"
SEED_MANAGER_PHONE="09120000000"
SEED_MANAGER_PASSWORD="CHANGE_ME"

# The client's (JTI) supervisor login. Leave the password empty to skip creating it.
SEED_CLIENT_NAME="ناظر جی‌تی‌آی"
SEED_CLIENT_PHONE="09121112000"
SEED_CLIENT_PASSWORD=""
